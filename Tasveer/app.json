{
  "expo": {
    "name": "Tasveer",
    "slug": "Tasveer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-dark.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/app-icon-dark.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tasveer",
      "config": {
        "googleMapsApiKey": "AIzaSyB7Haog03RkW-Jw_gjxDBt5reynjLGw4-c"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Tasveer needs to access your camera.",
        "NSMicrophoneUsageDescription": "Tasveer needs to use your microphone.",
        "NSPhotoLibraryUsageDescription": "Tasveer needs to access your media library.",
        "NSLocationWhenInUseUsageDescription": "Tasveer needs to track your current location."
      }
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon-dark.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.tasveer",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyB7Haog03RkW-Jw_gjxDBt5reynjLGw4-c"
        }
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/ProductSans-Black.ttf",
            "./assets/fonts/ProductSans-BlackItalic.ttf",
            "./assets/fonts/ProductSans-Bold.ttf",
            "./assets/fonts/ProductSans-BoldItalic.ttf",
            "./assets/fonts/ProductSans-Italic.ttf",
            "./assets/fonts/ProductSans-Light.ttf",
            "./assets/fonts/ProductSans-LightItalic.ttf",
            "./assets/fonts/ProductSans-Medium.ttf",
            "./assets/fonts/ProductSans-MediumItalic.ttf",
            "./assets/fonts/ProductSans-Regular.ttf",
            "./assets/fonts/ProductSans-Thin.ttf",
            "./assets/fonts/ProductSans-ThinItalic.ttf",
            "./assets/fonts/SF-Pro-Text-Bold.otf",
            "./assets/fonts/SF-Pro-Text-BoldItalic.otf",
            "./assets/fonts/SF-Pro-Text-Heavy.otf",
            "./assets/fonts/SF-Pro-Text-HeavyItalic.otf",
            "./assets/fonts/SF-Pro-Text-Light.otf",
            "./assets/fonts/SF-Pro-Text-LightItalic.otf",
            "./assets/fonts/SF-Pro-Text-Medium.otf",
            "./assets/fonts/SF-Pro-Text-MediumItalic.otf",
            "./assets/fonts/SF-Pro-Text-Regular.otf",
            "./assets/fonts/SF-Pro-Text-RegularItalic.otf",
            "./assets/fonts/SF-Pro-Text-Semibold.otf"
          ]
        }
      ],
      [
        "react-native-permissions",
        {
          "iosPermissions": [
            "Microphone",
            "Camera",
            "LocationWhenInUse",
            "PhotoLibrary"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ]
  }
}